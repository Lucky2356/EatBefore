<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are handled explicitly by the in-app export/import feature, never by
     the system cloud backup. Exclude everything from automatic transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
