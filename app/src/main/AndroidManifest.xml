<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications for expiry reminders (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera for barcode/QR scanning (runtime permission, requested on demand). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Internet for the optional external product-catalog lookup, and for checking
         GitHub Releases: the app is installed by hand, so nothing else would ever say
         that a new version exists. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installing the update the app downloaded itself. The user still has to allow this
         source once in system settings; the app only asks. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Camera is declared for the scanner feature (added in a later milestone).
         Not required to install so the app runs on camera-less devices. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".EatBeforeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EatBefore"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EatBefore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the notification's "not today" action. Not exported: only our own
             PendingIntent triggers it. -->
        <receiver
            android:name=".core.notifications.SnoozeReceiver"
            android:exported="false" />

        <!-- "Ate it" / "threw it out" straight from the reminder, when it is about one
             product. Not exported: only our own PendingIntent may write off stock. -->
        <receiver
            android:name=".core.notifications.ExpiryActionReceiver"
            android:exported="false" />

        <!-- Where the system reports how the update install went. Not exported: only the
             package installer, through our own PendingIntent, talks to it. -->
        <receiver
            android:name=".core.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Home-screen widget: what expires soonest. Exported so the launcher can host it. -->
        <receiver
            android:name=".feature.widget.ExpiringWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expiring_widget_info" />
        </receiver>

        <!-- Disable WorkManager's default initializer; the app provides its own
             HiltWorkerFactory-backed configuration (used from a later milestone). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
